{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "brandkit-prompts2products-com",
  "compatibility_date": "2026-09-17",
  "main": "src/worker.js",

  // Free allocation, no card. Powers POST /api/names only.
  "ai": {
    "binding": "AI"
  },

  // Caps how fast one visitor can spend the AI allowance.
  "ratelimits": [
    {
      "name": "NAMES_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],

  // Static site only: scripts/inject-analytics.js writes dist/ from index.html.
  "build": {
    "command": "node scripts/inject-analytics.js"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",

    // Without this the SPA fallback would serve index.html for /api/names
    // and the worker would never run.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "workers_dev": true,
  "routes": [
    {
      "pattern": "brandkit.prompts2products.com",
      "custom_domain": true
    }
  ]
}
