{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "brandkit-prompts2products-com",
  "compatibility_date": "2026-09-17",
  "main": "src/worker.js",

  // Free allocation, no card. Powers POST /api/names only.
  "ai": {
    "binding": "AI"
  },

  // Caps how fast one visitor can spend the AI allowance.
  // NAMES_RATE_EVENT is a looser cap for a room of people sharing one
  // Wi-Fi IP. The worker only uses it until EVENT_UNTIL, then falls back
  // to NAMES_RATE by itself, so nobody has to remember to undo it.
  "ratelimits": [
    {
      "name": "NAMES_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "NAMES_RATE_EVENT",
      "namespace_id": "1002",
      "simple": { "limit": 150, "period": 60 }
    }
  ],

  "vars": {
    // ISO time, UTC. Empty or in the past means the normal limit applies.
    "EVENT_UNTIL": "2026-10-10T12:00:00Z"
  },

  // Static site only: scripts/inject-analytics.js writes dist/ from index.html.
  "build": {
    "command": "node scripts/inject-analytics.js"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",

    // Without this the SPA fallback would serve index.html for /api/names
    // and the worker would never run.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "workers_dev": true,
  "routes": [
    {
      "pattern": "brandkit.prompts2products.com",
      "custom_domain": true
    }
  ]
}
